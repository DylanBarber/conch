{
    "name": "js-conch",
    "version": "1.0.0",
    "description": "WebRTC Group Voice Chat Application",
    "main": "dist/main/main.js",
    "scripts": {
        "start": "npm run build && electron .",
        "start:server": "node server/signaling-server.js",
        "dev": "concurrently \"npm run start:server\" \"npm run watch:main\" \"npm run watch:preload\" \"npm run watch:renderer\" \"wait-on dist/main/main.js dist/renderer/index.html && electron .\"",
        "build": "npm run build:main && npm run build:preload && npm run build:renderer",
        "build:main": "webpack --config webpack.main.config.js",
        "build:preload": "webpack --config webpack.preload.config.js",
        "build:renderer": "webpack --config webpack.renderer.config.js",
        "watch:main": "webpack --config webpack.main.config.js --watch",
        "watch:preload": "webpack --config webpack.preload.config.js --watch",
        "watch:renderer": "webpack --config webpack.renderer.config.js --watch",
        "typecheck": "tsc --noEmit",
        "package": "electron-builder",
        "dist": "npm run build && electron-builder"
    },
    "keywords": [
        "electron",
        "webrtc",
        "voice-chat",
        "typescript"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^20.10.0",
        "concurrently": "^8.2.2",
        "copy-webpack-plugin": "^11.0.0",
        "css-loader": "^6.8.1",
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1",
        "html-webpack-plugin": "^5.5.4",
        "style-loader": "^3.3.3",
        "ts-loader": "^9.5.1",
        "typescript": "^5.3.2",
        "wait-on": "^7.2.0",
        "webpack": "^5.89.0",
        "webpack-cli": "^5.1.4"
    },
    "dependencies": {
        "electron-store": "^8.1.0",
        "ws": "^8.14.2"
    },
    "build": {
        "appId": "com.jsconch.voicechat",
        "productName": "JS Conch Voice Chat",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "package.json"
        ],
        "win": {
            "target": "nsis"
        },
        "mac": {
            "target": "dmg"
        },
        "linux": {
            "target": "AppImage"
        }
    }
}